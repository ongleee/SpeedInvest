# ─────────────────────────────────────────────────
# web-backend Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────────

# OpenRouter API Key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use via OpenRouter
# Examples: anthropic/claude-3-5-sonnet, openai/gpt-4o, google/gemini-pro
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet

# Finnhub API Key (Tier 2 Fallback for stock quotes) — https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key_here

# Your site URL (used in OpenRouter request headers)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=SpeedInvest

# Optional: Restrict allowed origins (comma-separated)
# ALLOWED_ORIGINS=chrome-extension://your-extension-id
